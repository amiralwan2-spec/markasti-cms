{
  "name": "markasti-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind-input.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind-input.css -o ./public/tailwind.css --watch",
    "bump": "node scripts/bump-version.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --test functions/test/lib.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.mjs\"",
    "test:a11y": "firebase emulators:exec --only auth,firestore \"node tests/a11y/seed.mjs && playwright test\"",
    "deploy": "npm run build:css && npm run smoke && npm run bump && firebase deploy --only hosting",
    "deploy:all": "npm run build:css && npm run smoke && npm run test && npm run bump && firebase deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.48.2",
    "firebase": "^11.3.0",
    "firebase-admin": "^12.7.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "firebase-functions": "^7.2.5"
  }
}
